 #include <byteswap.h>
 #include <dlfcn.h>
 
+/* patches/0012: the 10a5:a921 frames its bulk records little-endian, while the
+ * 9800/a900 use big-endian. Route every on-the-wire 32-bit field through this
+ * so the rest of the driver stays unchanged. */
+static gboolean fpc_le_fields = FALSE;
+
+static inline guint32
+fpc32 (guint32 v)
+{
+  return fpc_le_fields ? GUINT32_FROM_LE (v) : fpc32 (v);
+}
